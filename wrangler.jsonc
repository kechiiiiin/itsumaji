{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "itsumaji",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-28",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "itsumaji-db",
			"database_id": "c2f872b0-1c6e-4ccc-8d6e-362de681dc2b"
		}
	],
	"triggers": {
		"crons": ["0 0 * * SUN", "0 1 * * SUN"]
	},
